---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';

import MainLayout from "../../layouts/ProjectLayout.astro"
import ProjectHeader from '../../components/ProjectHeader.astro';

import CodeBlock from "../../components/CodeBlock.astro"

export async function getStaticPaths() {
  const projectEntries = await getCollection('projects');
  return projectEntries.map(project => ({
    params: { slug: project.data.slug }, props: { project },
  }));
}

const { project } = Astro.props;
const { Content } = await render(project);
---



<MainLayout title="Projects">
  <ProjectHeader title={project.data.title} description={project.data.description} tags={project.data.tags} />
  <Content components={{pre: CodeBlock}} />
</MainLayout>
