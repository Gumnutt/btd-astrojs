---
export interface GridItemPosition {
  rowStart: number;
  rowEnd: number;
  columnStart: number;
  columnEnd: number;
}

export interface Props {
  rows: number;
  columns: number;
  itemPosition: GridItemPosition;
}

const { rows, columns, itemPosition} = Astro.props;
---
<section class="simple-grid-demo">
  <div class="underlay">
    <div class="rows">
      {Array.from({ length: rows + 1 }, (_, i) => (
        <div class="row">
          <div class="label">{i + 1}</div>
        </div>
      ))}
    </div>
    <div class="columns">
      {Array.from({ length: columns + 1 }, (_, i) => (
        <div class="column">
          <div class="label">{i + 1}</div>
        </div>
      ))}
    </div>
  </div>
  <div class="overlay">
    <div class="overlay-grid">
      <div class="item"></div>
    </div>
  </div>
</section>

<style define:vars={{ rows, columns, rowstart: itemPosition.rowStart, rowend: itemPosition.rowEnd, columnstart: itemPosition.columnStart, columnend: itemPosition.columnEnd }}>
.simple-grid-demo {
  position: relative;
  aspect-ratio: 5 / 2;
  -webkit-user-select: none;
  -moz-user-select: none;
  user-select: none;
  margin-block-start: calc(2rem + var(--rhythm));
  margin-block-end: var(--rhythm);
}
.underlay{
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  border: 1px solid var(--offwhite);
  border-radius: 4px;
}
.rows{
  position: absolute;
  inset: 4px;
  display: flex;
  justify-content: space-between;
  flex-direction: column;
}
.row{
  position: relative;
  margin-left: -16px;
  margin-right: -16px;
  border-top: 2px dashed color-mix(in srgb, var(--grey) 10%, var(--offwhite));
  .label{
    position: absolute;
    top: 0;
    right: -10px;
    transform: translate(100%, -55%);
    font-weight: var(--font-weight-bold);
  }
}
.columns{
  position: absolute;
  inset: 4px;
  display: flex;
  justify-content: space-between;
}
.column{
  position: relative;
  margin-top: -16px;
  margin-bottom: -16px;
  border-left: 2px dashed color-mix(in srgb, var(--grey) 10%, var(--offwhite));
}
.label{
  position: absolute;
  top: -16px;
  left: 3px;
  transform: translate(-100%, -50%);
  font-weight: var(--font-weight-bold);
}
.overlay{
  position: absolute;
  inset: 0;
  padding: 3px;
}
.overlay-grid{
  display: grid;
  grid-template-rows: repeat(var(--rows), 1fr);
  grid-template-columns: repeat(var(--columns), 1fr);
  padding: 4px;
  width: 100%;
  height: 100%;
}
.item {
  position: relative;
  display: flex;
  font-size: 1rem;
  padding: 2px;
  margin: 2px;
  background: color-mix(in srgb, var(--yellow) 80%, transparent);
  grid-area: var(--rowstart) / var(--columnstart) / var(--rowend) / var(--columnend);
  border-radius: 4px;
  border: 2px solid var(--yellow);
}
</style>