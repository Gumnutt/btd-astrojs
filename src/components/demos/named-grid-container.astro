<section class="complex-grid-demo">
  <div class="underlay">
    <div class="rows">
      <div class="row">
        <div class="label">1</div>
      </div>
      <div class="row">
        <div class="label">2</div>
      </div>
      <div class="row">
        <div class="label">3</div>
      </div>
      <div class="row">
        <div class="label">4</div>
      </div>
      <div class="row">
        <div class="label">5</div>
      </div>
      <div class="row">
        <div class="label">6</div>
      </div>
      <div class="row">
        <div class="label">7</div>
      </div>
    </div>
    <div class="columns">
      <div class="column">
        <div class="label">a-start</div>
      </div>
      <span></span>
      <div class="column">
        <div class="label">b-start</div>
      </div>
      <div class="column">
        <div class="label">c-start</div>
      </div>
      <span></span>
      <span></span>
      <div class="column">
        <div class="label">c-end</div>
      </div>
      <div class="column">
        <div class="label">b-end</div>
      </div>
      <span></span>
      <div class="column">
        <div class="label">a-end</div>
      </div>
    </div>
  </div>
  <div class="overlay">
    <div class="overlay-grid">
      <div class="item">C Track</div>
      <div class="item">B Track</div>
      <div class="item">C Track</div>
      <div class="item">A Track</div>
      <div class="item">C Track</div>
      <div class="item">C Track</div>
    </div>
  </div>
</section>

<style>
.complex-grid-demo {
  position: relative;
  aspect-ratio: 5 / 2;
  -webkit-user-select: none;
  -moz-user-select: none;
  user-select: none;
  margin-block-start: calc(5rem + var(--rhythm));
  margin-block-end: var(--rhythm);
}
.underlay{
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  border: 1px solid var(--offwhite);
  border-radius: 4px;
}
.rows{
  position: absolute;
  inset: 4px;
  display: flex;
  justify-content: space-between;
  flex-direction: column;
}
.row{
  position: relative;
  margin-left: -16px;
  margin-right: -16px;
  border-top: 2px dashed color-mix(in srgb, var(--grey) 10%, var(--offwhite));
  .label{
    position: absolute;
    top: 0;
    right: -10px;
    transform: translate(100%, -55%);
    font-weight: var(--font-weight-bold);
  }
}
.columns{
  position: absolute;
  inset: 4px;
  display: flex;
  justify-content: space-between;
}
.column{
  position: relative;
  margin-top: -16px;
  margin-bottom: -16px;
  border-left: 2px dashed color-mix(in srgb, var(--grey) 10%, var(--offwhite));
  .label{
      position: absolute;
      top: -38px;
      left: 15px;
      transform: translate(-100%, -50%);
      font-weight: var(--font-weight-bold);
      writing-mode: sideways-lr;
    }
}

.overlay{
  position: absolute;
  inset: 0;
  padding: 3px;
}
.overlay-grid{
  display: grid;
  grid-template-rows: repeat(6, 1fr);
  grid-template-columns: repeat(9, 1fr);
  padding: 4px;
  width: 100%;
  height: 100%;
  grid-auto-flow: column;
}
.item {
  position: relative;
  display: flex;
  font-size: 1rem;
  padding: 2px;
  margin: 2px;
  background: color-mix(in srgb, var(--yellow) 80%, transparent);
  border-radius: 4px;
  border: 2px solid var(--yellow);
  grid-column: 4 / 7;
  text-align: center;
  color: var(--yellow);
  align-items: center;
  justify-content: center;
  &:nth-child(2){
    grid-column: 3 / 8;
  }
  &:nth-child(4){
    grid-column: 1 / -1;
  }
}
</style>