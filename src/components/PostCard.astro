---
export interface Props {
  title: string
  short_content: string
  slug: string
  author?: string
  date?: Date
  tags?: string[]
}

import Chip from './Chip.astro'

const { title, short_content, slug, author, date, tags } = Astro.props

const formattedDate = date
  ? new Intl.DateTimeFormat('en-AU', { day: 'numeric', month: 'short', year: 'numeric'}).format(date)
  : null;
---


<a href={`/posts/${slug}`} class="post--card" transition:name=`${slug}-hero`>
  <h3>{title}</h3>
  <p>{short_content}</p>
  <footer>
      <p>By {author}</p>
      {formattedDate && <time>{formattedDate}</time>}
    {tags && tags.map((tag) => (
      <Chip>{tag}</Chip>
    ))}
  </footer>
</a>

