---
interface Props {
  site_url: string
  title: string
}

const uuid = crypto.randomUUID()

const { site_url, title } = Astro.props
---
<div class="preview-frame" data-id={uuid}>
  <header class="preview-frame__header">
    <h3>{title}</h3>
    <div class="preview-frame__actions">
      <button data-control-target=`control-${uuid}`>Activate preview</button>
    </div>
  </header>
  <div class="preview-frame__inner">
    <iframe src={site_url} loading="lazy" title={title}></iframe>
    <div class="preview-frame__controls ">
      <input type="range" id=`control-${uuid}` min="30" max="100" value="100" step="1"> 
      <label for=`control-${uuid}`>Resize viewport</label>
    </div>
    
  </div>
</div>

<script>
  document.addEventListener('astro:page-load', ()=>{
    const previewFrames = document.querySelectorAll('.preview-frame')
    let locked = true

    previewFrames.forEach((frame) => {
      const id = frame.dataset.id
      const range = frame.querySelector(`#control-${id}`)
      const button = frame.querySelector(`button`)

      //make the frame inert
      frame.querySelector('iframe').setAttribute('inert', true)

      //watch for changes on the range input
      range.addEventListener('input', (e) => {
        const value = e.target.value
        frame.style.setProperty('--vp-width', value)
      })

      button.addEventListener('click', (e) => {
        locked = !locked
        if (locked) {
          button.innerText = 'Activate preview'
          button.classList.remove('active')
          frame.querySelector('iframe').setAttribute('inert', true)
        } else {
          button.innerText = 'Deactivate preview'
          button.classList.add('active')
          frame.querySelector('iframe').removeAttribute('inert')
        }
      })
      
    })
  })
</script>