---
export interface Props {
  title: string;
  level: number;
  backgroundColor?: "purple" | "pink" | "blue" | "yellow" | "white" | "black";
  size?: "sm" | "md" | "lg";
}

const { title, level, backgroundColor, size } = Astro.props;

if (level < 1 || level > 6) {
  throw new Error("Level must be between 1 and 6");
}
---

{(() => {
  const Tag = `h${level}`;
  return <Tag class="block-heading" data-mark-bg={backgroundColor} data-size={size}><mark>{title}</mark></Tag>;
})()}