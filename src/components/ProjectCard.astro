---
import { Image } from 'astro:assets';
import Pill from './Pill.astro';
export interface Props {
  title: string
  slug: string
  image?: string
  description?: string
  tags?: string[]
}

const colors = [
  "purple",
]
const randomColor = colors[Math.floor(Math.random() * colors.length)]

const { title, slug, image, description, tags } = Astro.props
---

<a href={slug} class="project--card" data-bg-color={randomColor}>
  <div class="project--tags">
    {tags && tags.map((tag) => (
      <Pill>{tag}</Pill>
    ))}
  </div>
  <h3>{title}</h3>
  {description &&<p>{description}</p>}
</a>

