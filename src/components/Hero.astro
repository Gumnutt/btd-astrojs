---
export interface Props {
  title: string
  description: string
}

import BlockHeading from "./BlockHeading.astro"

const { title, description } = Astro.props
---

<section class="hero">
  <div class="wrapper">
    <div class="hero--layout">
      <BlockHeading title={title} level={1} backgroundColor="purple" size="lg" />
      <p class="hero--subtext">{description}</p>
    </div>
  </div>
</section>