---
import BlockHeading from './BlockHeading.astro';
export interface Post {
  data: {
    published: Date;
    title: string;
    slug: string;
  };
  body: string;
}
export interface Props {
  post: Post
}

const { post } = Astro.props

const formattedDate = post.data.published
  ? new Intl.DateTimeFormat('en-AU', { day: 'numeric', month: 'long', year: 'numeric'}).format(post.data.published)
  : null;
---
<div class="post--header" transition:name=`${post.data.slug}-hero`>
  <BlockHeading level={1} title={post.data.title} size='lg' backgroundColor='white'/>
    <!-- <div class="header--data">
      <time>{moment(post.data.published).format("MMM Do")}</time>
      <span>~</span>
      <span>{Math.ceil(post.body.trim().split(/\s+/).length / 200)} min read</span>
    </div> -->
    <footer>

      {formattedDate && <time>{formattedDate}</time>}

    </footer>

</div>